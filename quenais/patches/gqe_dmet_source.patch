+    def _quenais_dump(self, result):
+        """QuEnAIS: write the best global-refined determinant set to
+        $QUENAIS_GQE_DUMP (pickle) each time it improves, so several runs
+        can be merged afterwards (tools/gqe_ensemble.py). No-op if unset;
+        never raises."""
+        import os
+        import pickle
+
+        path = os.environ.get("QUENAIS_GQE_DUMP")
+        if not path:
+            return
+        try:
+            sci = self.qsci_pipeline.global_refined_scistates
+            strs = getattr(sci, "_strs", None)
+            # _strs is the determinant LIST, one (alpha, beta) occupation
+            # pair per determinant -- not a pair of string lists.
+            data = {
+                "energy": float(result.energy),
+                "epoch": int(self.current_epoch),
+                "subspace_dim": getattr(result, "subspace_dim", None),
+                "dets": None if strs is None else np.asarray(strs),
+                "coeffs": np.asarray(sci),
+            }
+            try:
+                pickle.dumps(result)
+                data["result"] = result
+            except Exception:
+                pass
+            tmp = path + ".tmp"
+            with open(tmp, "wb") as fh:
+                pickle.dump(data, fh)
+            os.replace(tmp, path)
+        except Exception as exc:
+            print(f"[quenais dump] failed: {exc}", flush=True)
+
