{
  "name": "h_chain_gqe",
  "description": "First DMET+GQE test where DMET really embeds: linear H chains, STO-3G, impurity = AVAS on the central atoms only (atom-indexed labels). H10 with 2 central atoms (impurity 2-3 orbitals, embedding <=6 of 10) as a cheap pipeline check; H14 with 4 central atoms (impurity 5-6, embedding <=12 of 14, 24 qubits) as the main test. Whole-molecule FCI is in the row, so the embedding error (DMET exact vs FCI) is measured exactly. Order: h10 check, h14 probe, h14 curve (CCSD + free angles, seeds 4-5), h14 budget 200. Then tools/selection_baselines.py. --out $B/h_chain.",
  "defaults": {
    "basis": "sto-3g",
    "active_space_method": "avas",
    "classical_methods": [
      "HF",
      "MP2",
      "CCSD",
      "CCSD_T",
      "CASCI",
      "FCI"
    ],
    "dmet_reference": "casci",
    "ansatz": "lucj",
    "mapping": "jw",
    "backend": "mps",
    "lassqd_lucj_optimize": true,
    "lassqd_carryover_eps": 1e-05,
    "shots": 10000,
    "cudaq_target": "nvidia",
    "gqe_ngates": 80,
    "gqe_basis": "mo",
    "molecule": "H14",
    "avas_ao_labels": [
      "5 H 1s",
      "6 H 1s",
      "7 H 1s",
      "8 H 1s"
    ]
  },
