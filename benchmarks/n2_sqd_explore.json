{
  "name": "n2_sqd_explore",
  "description": "N2 STO-3G, optimised LUCJ (all pairs, 2 reps), d = all samples. At 10k shots it samples only 60-200 distinct determinants (1.5-17% of the space): fine at 1.1-1.4, 2.0, 2.25 A (1-3 kcal/mol) but 9-28 at 1.6/1.8 and erratic at 2.5 (0.5 / 109 / 155). Test the two coverage fixes on those points (+1.1 A as control): 100k shots, and 25/50% exploration shots at scale 0.3/1.0. The 10k baseline rows are the finished n2_sqd_opt runs (skipped). Circuits cached: ~150 s per run. --out $B/n2_curve.",
  "defaults": {
    "molecule": "N2",
    "basis": "sto-3g",
    "active_space_method": "avas",
    "avas_ao_labels": [
      "N 2s",
      "N 2p"
    ],
    "classical_methods": [
      "HF",
      "MP2",
      "CCSD",
      "CCSD_T",
      "CASSCF",
      "CASCI",
      "FCI"
    ],
    "dmet_reference": "casci",
    "ansatz": "lucj",
    "mapping": "jw",
    "backend": "mps",
    "lassqd_lucj_optimize": true,
    "lassqd_carryover_eps": 1e-05,
    "shots": 10000
  },
  "studies": [
    {
      "name": "shots",
      "cases": [
        {
          "geometry": "N 0 0 0; N 0 0 1.1",
          "tag_R": 1.1
        },
        {
          "geometry": "N 0 0 0; N 0 0 1.6",
          "tag_R": 1.6
        },
        {
          "geometry": "N 0 0 0; N 0 0 1.8",
          "tag_R": 1.8
        },
        {
          "geometry": "N 0 0 0; N 0 0 2.5",
          "tag_R": 2.5
        }
      ],
      "sweep": {
        "solver": [
          "sqd"
        ],
        "ansatz": [
          "lucj_opt"
        ],
        "sqd_lucj_pairs": [
          "all"
        ],
        "sqd_lucj_reps": [
          2
        ],
        "seed": [
          1,
          2,
          3
        ],
        "sqd_samples_per_batch": [
          1000000
        ],
        "sqd_batches": [
          1
        ],
        "shots": [
          10000,
          100000
        ]
      }
    },
    {
      "name": "explore",
      "cases": [
        {
          "geometry": "N 0 0 0; N 0 0 1.1",
          "tag_R": 1.1
        },
        {
          "geometry": "N 0 0 0; N 0 0 1.6",
          "tag_R": 1.6
        },
        {
          "geometry": "N 0 0 0; N 0 0 1.8",
          "tag_R": 1.8
        },
        {
          "geometry": "N 0 0 0; N 0 0 2.5",
          "tag_R": 2.5
        }
      ],
      "sweep": {
        "solver": [
          "sqd"
        ],
        "ansatz": [
          "lucj_opt"
        ],
        "sqd_lucj_pairs": [
          "all"
        ],
        "sqd_lucj_reps": [
          2
        ],
        "seed": [
          1,
          2,
          3
        ],
        "sqd_samples_per_batch": [
          1000000
        ],
        "sqd_batches": [
          1
        ],
        "shots": [
          10000
        ],
        "sqd_explore_fraction": [
          0.25,
          0.5
        ],
