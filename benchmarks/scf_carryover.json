{
  "name": "scf_carryover",
  "description": "ScF carryover study (Wang et al. PNAS 2026, Algorithm 2) with seed repeats. Same system and defaults as scf_quick.json, so its 12 runs are reused when --out points at the same folder.",
  "defaults": {
    "molecule": "ScF", "basis": "sto-3g",
    "active_space_method": "avas", "avas_ao_labels": ["Sc 3d", "Sc 4s", "F 2p"],
    "classical_methods": ["HF", "MP2", "CCSD", "CCSD_T", "CASSCF", "CASCI"],
    "las_fragments": ["Sc:6:1,1", "F:3:3,3"],
    "lassqd_lucj_optimize": true
  },
  "studies": [
    {"name": "carryover", "fixed": {"solver": "lassqd"},
     "sweep": {"lassqd_carryover_eps": [0, 1e-6, 1e-5, 1e-4],
               "shots": [1000, 3000, 10000, 30000],
               "seed": [1, 2, 3, 4, 5]}},
    {"name": "reference", "fixed": {"solver": "lasscf"}}
  ]
}