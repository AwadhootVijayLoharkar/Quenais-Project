{
  "name": "n2_gqe_ens",
  "description": "GQE ensembles on DMET N2: 80 gates (best setting from n2_gqe_tune), 120 epochs, NEW seeds 4-8 so every run writes its determinant set (patched trainer; the seed 1-3 runs predate the dump). Then: python tools/gqe_ensemble.py $B/n2_curve --where gqe_ngates=80 tag_R=2.1 (and 1.8). --out $B/n2_curve.",
  "defaults": {
    "molecule": "N2",
    "basis": "sto-3g",
    "active_space_method": "avas",
    "avas_ao_labels": [
      "N 2s",
      "N 2p"
    ],
    "classical_methods": [
      "HF",
      "MP2",
      "CCSD",
      "CCSD_T",
      "CASSCF",
      "CASCI",
      "FCI"
    ],
    "dmet_reference": "casci",
    "ansatz": "lucj",
    "mapping": "jw",
    "backend": "mps",
    "lassqd_lucj_optimize": true,
    "lassqd_carryover_eps": 1e-05,
    "shots": 10000,
    "cudaq_target": "nvidia",
    "gqe_ngates": 80
  },
  "studies": [
    {
      "name": "gqe_ens",
      "cases": [
        {
          "geometry": "N 0 0 0; N 0 0 1.8",
          "tag_R": 1.8
        },
        {
          "geometry": "N 0 0 0; N 0 0 2.1",
          "tag_R": 2.1
        }
      ],
      "sweep": {
        "solver": [
          "gqe"
        ],
        "seed": [
          4,
          5,
          6,
          7,
          8
        ]
      }
    }
  ]
}
