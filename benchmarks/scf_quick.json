    "active_space_method": "avas", "avas_ao_labels": ["Sc 3d", "Sc 4s", "F 2p"],
    "classical_methods": ["HF", "MP2", "CCSD", "CCSD_T", "CASSCF", "CASCI"],
    "las_fragments": ["Sc:6:1,1", "F:3:3,3"],
    "lassqd_lucj_optimize": true
