{
  "name": "n2_gqe_tune",
  "description": "Task 3b: GQE tuning on DMET-embedded N2 at R = 1.8 and 2.1 A. gqe_ngates 40/80 x gqe_max_iters 120/300 x seeds 1-3 = 24 runs. null = the default (40 gates, 120 epochs): those 6 runs are identical to n2_gqe.json's and are SKIPPED as done when --out is $B/n2_curve, so 18 new runs. Same defaults as n2_gqe.json.",
  "defaults": {
    "molecule": "N2",
    "basis": "sto-3g",
    "active_space_method": "avas",
    "avas_ao_labels": [
      "N 2s",
      "N 2p"
    ],
    "classical_methods": [
      "HF",
      "MP2",
      "CCSD",
      "CCSD_T",
      "CASSCF",
      "CASCI",
      "FCI"
    ],
    "dmet_reference": "casci",
    "ansatz": "lucj",
    "mapping": "jw",
    "backend": "mps",
    "lassqd_lucj_optimize": true,
    "lassqd_carryover_eps": 1e-05,
    "shots": 10000,
    "cudaq_target": "nvidia"
  },
  "studies": [
    {
      "name": "gqe_tune",
      "cases": [
        {
          "geometry": "N 0 0 0; N 0 0 1.8",
          "tag_R": 1.8
        },
        {
          "geometry": "N 0 0 0; N 0 0 2.1",
          "tag_R": 2.1
        }
      ],
      "sweep": {
        "solver": [
          "gqe"
        ],
        "gqe_ngates": [
          null,
          80
        ],
        "gqe_max_iters": [
          null,
          300
        ],
        "seed": [
          1,
          2,
          3
        ]
      }
    }
  ]
}
