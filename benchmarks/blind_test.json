{
  "name": "blind_test",
  "description": "Blind test of the compactness router on systems it was not tuned on (answer to reviewer: generalization). Router rule frozen at the router_margin commit: GENIE if 3 n_est <= N, deeper if n_est <= N < 3 n_est, else not GENIE. Predictions are written with tools/regime_diagnostics.py BEFORE looking at GENIE errors. H2O 6-31G, AVAS O 2s2p + H 1s (full valence, ~24 qubits), symmetric stretch; H12 ring STO-3G, 6-atom impurity (12 embedded orbitals, 24 qubits). CCSD angles, 80 gates, 120 epochs, cap 1e4 (2 seeds) and budget 200 (1 seed). Run on both A100s without --shard (run locks split the work). W2 needs GQE_QSCI_REPO_PATH=.../gqe-for-qsci_w2. Set QUENAIS_SELECTION_MAX_DET=4000000. --out $B/blind.",
  "defaults": {
    "active_space_method": "avas",
    "classical_methods": [
      "HF",
      "MP2",
      "CCSD",
      "CCSD_T",
      "CASCI"
    ],
    "dmet_reference": "casci",
    "ansatz": "lucj",
    "mapping": "jw",
    "backend": "mps",
    "lassqd_lucj_optimize": true,
    "lassqd_carryover_eps": 1e-05,
    "shots": 10000,
    "cudaq_target": "nvidia",
    "gqe_ngates": 80,
    "gqe_basis": "mo"
  },
